+let thumbnailGeneration = 0;
+const thumbnailDisposers = new Set<() => void>();
+export function clearThumbnailCache() {
+  thumbnailGeneration += 1;
+  for (const dispose of thumbnailDisposers) dispose();
+  thumbnailDisposers.clear();
