diff --git a/src/leesfield/audio-operation-processor.ts b/src/leesfield/audio-operation-processor.ts
new file mode 100644
--- /dev/null
+++ b/src/leesfield/audio-operation-processor.ts
@@ -0,0 +1,288 @@
+import { ALL_FORMATS, BlobSource, Input } from "mediabunny";
+
+import { applyFades, decodeAudioBlobAsync } from "../hooks/useAudioMixing";
+
+export type AudioEditParameters = {
+  startMs: number;
+  endMs: number;
+  offsetMs: number;
+  fadeInMs: number;
+  fadeOutMs: number;
+};
+
+export type AudioOperationInput = {
+  assetId: string;
+  portId: "audio";
+  sortOrder: number;
+  type: "audio";
+  mimeType: string;
+  url: string;
+};
+
+export type AudioOperationRequest = {
+  kind: "edit.audio.basic";
+  parameters: AudioEditParameters;
+  inputs: AudioOperationInput[];
+  signal?: AbortSignal;
+  onProgress?: (progress: number) => void;
+};
+
+export type AudioOperationResultItem = {
+  blob: Blob;
+  fileName: "audio-edit.wav";
+  mimeType: "audio/wav";
+  sortOrder: 0;
+  bytes: number;
+  sampleRate: number;
+  channels: number;
+  durationMs: number;
+};
+
+export type AudioOperationResult = { outputs: [AudioOperationResultItem] };
+
+const MAX_DURATION_MS = 600_000;
+const MAX_INPUT_BYTES = 100 * 1024 * 1024;
+const PCM_HEADER_BYTES = 44;
+const PCM_BITS_PER_SAMPLE = 16;
+
+function throwIfAborted(signal?: AbortSignal) {
+  if (signal?.aborted) throw new DOMException("Audio operation cancelled", "AbortError");
+}
+
+function integerInRange(value: unknown, minimum: number, maximum: number) {
+  return typeof value === "number" && Number.isInteger(value) && value >= minimum && value <= maximum;
+}
+
+function assertRequest(request: AudioOperationRequest) {
+  if (request.kind !== "edit.audio.basic") throw new Error("AUDIO_OPERATION_KIND_INVALID");
+  if (
+    request.inputs.length !== 1 ||
+    request.inputs[0]?.type !== "audio" ||
+    request.inputs[0]?.portId !== "audio" ||
+    request.inputs[0]?.sortOrder !== 0
+  ) {
+    throw new Error("AUDIO_OPERATION_INPUT_INVALID");
+  }
+  const parameters = request.parameters;
+  if (
+    !integerInRange(parameters.startMs, 0, MAX_DURATION_MS) ||
+    !integerInRange(parameters.endMs, 1, MAX_DURATION_MS) ||
+    !integerInRange(parameters.offsetMs, -MAX_DURATION_MS, MAX_DURATION_MS) ||
+    !integerInRange(parameters.fadeInMs, 0, MAX_DURATION_MS) ||
+    !integerInRange(parameters.fadeOutMs, 0, MAX_DURATION_MS)
+  ) {
+    throw new Error("AUDIO_OPERATION_PARAMETERS_INVALID");
+  }
+  const trimmedDurationMs = parameters.endMs - parameters.startMs;
+  const outputDurationMs = trimmedDurationMs + parameters.offsetMs;
+  const retainedAudioDurationMs = trimmedDurationMs + Math.min(0, parameters.offsetMs);
+  if (
+    trimmedDurationMs <= 0 ||
+    outputDurationMs <= 0 ||
+    outputDurationMs > MAX_DURATION_MS ||
+    parameters.fadeInMs + parameters.fadeOutMs > retainedAudioDurationMs
+  ) {
+    throw new Error("AUDIO_OPERATION_INTERVAL_INVALID");
+  }
+}
+
+async function fetchInput(input: AudioOperationInput, signal?: AbortSignal) {
+  throwIfAborted(signal);
+  const response = await fetch(input.url, { cache: "no-store", signal });
+  if (!response.ok) throw new Error(`AUDIO_INPUT_FETCH_FAILED:${input.assetId}`);
+  const blob = await response.blob();
+  throwIfAborted(signal);
+  if (blob.size <= 0 || blob.size > MAX_INPUT_BYTES) throw new Error("AUDIO_INPUT_SIZE_INVALID");
+  return blob.type ? blob : new Blob([blob], { type: input.mimeType });
+}
+
+function millisecondsToSamples(milliseconds: number, sampleRate: number) {
+  return Math.round(milliseconds * sampleRate / 1_000);
+}
+
+function mergeDecodedBuffers(buffers: AudioBuffer[], signal?: AbortSignal) {
+  const first = buffers[0];
+  if (!first || first.length <= 0 || first.numberOfChannels <= 0 || first.sampleRate <= 0) {
+    throw new Error("AUDIO_DECODE_EMPTY");
+  }
+  const totalSamples = buffers.reduce((total, buffer) => {
+    if (buffer.sampleRate !== first.sampleRate || buffer.numberOfChannels !== first.numberOfChannels) {
+      throw new Error("AUDIO_DECODE_FORMAT_CHANGED");
+    }
+    return total + buffer.length;
+  }, 0);
+  const merged = new AudioBuffer({
+    length: totalSamples,
+    numberOfChannels: first.numberOfChannels,
+    sampleRate: first.sampleRate,
+  });
+  let writeOffset = 0;
+  for (const buffer of buffers) {
+    throwIfAborted(signal);
+    for (let channel = 0; channel < first.numberOfChannels; channel += 1) {
+      merged.getChannelData(channel).set(buffer.getChannelData(channel), writeOffset);
+    }
+    writeOffset += buffer.length;
+  }
+  return merged;
+}
+
+function editSamples(source: AudioBuffer, parameters: AudioEditParameters, signal?: AbortSignal) {
+  const startSample = millisecondsToSamples(parameters.startMs, source.sampleRate);
+  const endSample = millisecondsToSamples(parameters.endMs, source.sampleRate);
+  if (startSample < 0 || endSample > source.length || endSample <= startSample) {
+    throw new Error("AUDIO_OPERATION_SOURCE_INTERVAL_INVALID");
+  }
+  const offsetSamples = millisecondsToSamples(parameters.offsetMs, source.sampleRate);
+  const sourceSkipSamples = Math.max(0, -offsetSamples);
+  const leadingSilenceSamples = Math.max(0, offsetSamples);
+  const retainedSamples = endSample - startSample - sourceSkipSamples;
+  if (retainedSamples <= 0) throw new Error("AUDIO_OPERATION_OUTPUT_EMPTY");
+
+  const retained = new AudioBuffer({
+    length: retainedSamples,
+    numberOfChannels: source.numberOfChannels,
+    sampleRate: source.sampleRate,
+  });
+  for (let channel = 0; channel < source.numberOfChannels; channel += 1) {
+    throwIfAborted(signal);
+    retained.getChannelData(channel).set(
+      source.getChannelData(channel).subarray(startSample + sourceSkipSamples, endSample),
+    );
+  }
+  applyFades(retained, {
+    fadeIn: parameters.fadeInMs / 1_000,
+    fadeOut: parameters.fadeOutMs / 1_000,
+  });
+
+  const output = new AudioBuffer({
+    length: leadingSilenceSamples + retainedSamples,
+    numberOfChannels: source.numberOfChannels,
+    sampleRate: source.sampleRate,
+  });
+  for (let channel = 0; channel < source.numberOfChannels; channel += 1) {
+    throwIfAborted(signal);
+    output.getChannelData(channel).set(retained.getChannelData(channel), leadingSilenceSamples);
+  }
+  return output;
+}
+
+function writeAscii(view: DataView, offset: number, value: string) {
+  for (let index = 0; index < value.length; index += 1) {
+    view.setUint8(offset + index, value.charCodeAt(index));
+  }
+}
+
+function encodePcmWav(buffer: AudioBuffer, signal?: AbortSignal) {
+  const bytesPerSample = PCM_BITS_PER_SAMPLE / 8;
+  const dataBytes = buffer.length * buffer.numberOfChannels * bytesPerSample;
+  const arrayBuffer = new ArrayBuffer(PCM_HEADER_BYTES + dataBytes);
+  const view = new DataView(arrayBuffer);
+  writeAscii(view, 0, "RIFF");
+  view.setUint32(4, arrayBuffer.byteLength - 8, true);
+  writeAscii(view, 8, "WAVE");
+  writeAscii(view, 12, "fmt ");
+  view.setUint32(16, 16, true);
+  view.setUint16(20, 1, true);
+  view.setUint16(22, buffer.numberOfChannels, true);
+  view.setUint32(24, buffer.sampleRate, true);
+  view.setUint32(28, buffer.sampleRate * buffer.numberOfChannels * bytesPerSample, true);
+  view.setUint16(32, buffer.numberOfChannels * bytesPerSample, true);
+  view.setUint16(34, PCM_BITS_PER_SAMPLE, true);
+  writeAscii(view, 36, "data");
+  view.setUint32(40, dataBytes, true);
+
+  let byteOffset = PCM_HEADER_BYTES;
+  for (let sampleIndex = 0; sampleIndex < buffer.length; sampleIndex += 1) {
+    if (sampleIndex % 8_192 === 0) throwIfAborted(signal);
+    for (let channel = 0; channel < buffer.numberOfChannels; channel += 1) {
+      const sample = Math.max(-1, Math.min(1, buffer.getChannelData(channel)[sampleIndex]));
+      view.setInt16(byteOffset, Math.round(sample < 0 ? sample * 0x8000 : sample * 0x7fff), true);
+      byteOffset += bytesPerSample;
+    }
+  }
+  throwIfAborted(signal);
+  return new Blob([arrayBuffer], { type: "audio/wav" });
+}
+
+function assertPcmHeader(blobBuffer: ArrayBuffer, expected: AudioBuffer) {
+  if (blobBuffer.byteLength < PCM_HEADER_BYTES) throw new Error("AUDIO_OUTPUT_WAV_INVALID");
+  const view = new DataView(blobBuffer);
+  const ascii = (offset: number, length: number) => String.fromCharCode(
+    ...new Uint8Array(blobBuffer, offset, length),
+  );
+  if (
+    ascii(0, 4) !== "RIFF" ||
+    ascii(8, 4) !== "WAVE" ||
+    ascii(12, 4) !== "fmt " ||
+    view.getUint16(20, true) !== 1 ||
+    view.getUint16(22, true) !== expected.numberOfChannels ||
+    view.getUint32(24, true) !== expected.sampleRate ||
+    view.getUint16(34, true) !== PCM_BITS_PER_SAMPLE ||
+    ascii(36, 4) !== "data" ||
+    view.getUint32(40, true) !== blobBuffer.byteLength - PCM_HEADER_BYTES
+  ) {
+    throw new Error("AUDIO_OUTPUT_WAV_INVALID");
+  }
+}
+
+async function verifyOutput(blob: Blob, expected: AudioBuffer, signal?: AbortSignal) {
+  if (blob.type !== "audio/wav" || blob.size <= PCM_HEADER_BYTES) {
+    throw new Error("AUDIO_OUTPUT_MIME_INVALID");
+  }
+  const bytes = await blob.arrayBuffer();
+  throwIfAborted(signal);
+  assertPcmHeader(bytes, expected);
+  const input = new Input({ source: new BlobSource(blob), formats: ALL_FORMATS });
+  try {
+    const [track, duration] = await Promise.all([
+      input.getPrimaryAudioTrack(),
+      input.computeDuration(),
+    ]);
+    if (!track || !(await track.canDecode())) throw new Error("AUDIO_OUTPUT_TRACK_INVALID");
+    if (track.numberOfChannels !== expected.numberOfChannels || track.sampleRate !== expected.sampleRate) {
+      throw new Error("AUDIO_OUTPUT_FORMAT_INVALID");
+    }
+    const durationMs = Math.round(duration * 1_000);
+    const expectedDurationMs = Math.round(expected.length / expected.sampleRate * 1_000);
+    if (Math.abs(durationMs - expectedDurationMs) > 1) throw new Error("AUDIO_OUTPUT_DURATION_INVALID");
+    return durationMs;
+  } finally {
+    input.dispose();
+  }
+}
+
+export async function processAudioOperation(request: AudioOperationRequest): Promise<AudioOperationResult> {
+  assertRequest(request);
+  throwIfAborted(request.signal);
+  if (typeof AudioBuffer === "undefined") throw new Error("AUDIO_BUFFER_UNAVAILABLE");
+  request.onProgress?.(5);
+  const inputBlob = await fetchInput(request.inputs[0], request.signal);
+  request.onProgress?.(15);
+  const decoded = await decodeAudioBlobAsync(
+    inputBlob,
+    ({ progress }) => request.onProgress?.(15 + progress * 0.35),
+    request.signal,
+  );
+  throwIfAborted(request.signal);
+  const source = mergeDecodedBuffers(decoded, request.signal);
+  request.onProgress?.(55);
+  const edited = editSamples(source, request.parameters, request.signal);
+  request.onProgress?.(70);
+  const blob = encodePcmWav(edited, request.signal);
+  request.onProgress?.(85);
+  const durationMs = await verifyOutput(blob, edited, request.signal);
+  request.onProgress?.(100);
+  return {
+    outputs: [{
+      blob,
+      fileName: "audio-edit.wav",
+      mimeType: "audio/wav",
+      sortOrder: 0,
+      bytes: blob.size,
+      sampleRate: edited.sampleRate,
+      channels: edited.numberOfChannels,
+      durationMs,
+    }],
+  };
+}
