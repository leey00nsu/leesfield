+    id: "complete",
+    message: "You're all set! Happy creating.",
+    position: "top-center",
+    completed: false,
+  },
+];
+export const hostedTutorialSteps = initialTutorialSteps.filter((step) => !["populate-content", "explain-run-options", "demonstrate-downstream", "resources"].includes(step.id)).map((step) => {
+  if (step.id === "explain-run-button") return { ...step, message: "Choose a model, upload your image and write a prompt. Run the Generate Image node when you are ready.", highlightSelector: '[title="Run this node"]' };
+  if (step.id === "run-workflow") return { ...step, message: "Run your Generate Image node to create an image. You can skip the tutorial at any time.", highlightSelector: '[title="Run this node"]' };
+  if (step.id === "save-project") return { ...step, message: "Your Space saves automatically. Use Save to check that the latest changes reached the server." };
+  return step;
+});
