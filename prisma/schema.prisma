generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum ImageGenerationStatus {
  pending
  processing
  completed
  failed
}

model ImageGeneration {
  id             String                 @id @default(cuid())
  requestId      String                 @unique
  prompt         String
  requestParams  Json?
  aspectRatio    String
  imageCount     Int
  steps          Int
  seed           String?
  status         ImageGenerationStatus
  progress       Int
  errorMessage   String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  images         ImageGenerationImage[]
}

model ImageGenerationImage {
  id           String          @id @default(cuid())
  generationId String
  url          String
  width        Int?
  height       Int?
  createdAt    DateTime        @default(now())
  generation   ImageGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([generationId])
}
