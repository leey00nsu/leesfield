// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ImageGenerationStatus {
  pending
  processing
  uploading
  completed
  failed
  cancelled
}

enum VideoGenerationStatus {
  pending
  processing
  uploading
  completed
  failed
  cancelled
}

enum AudioGenerationStatus {
  pending
  processing
  uploading
  completed
  failed
  cancelled
}

enum ApiKeyStatus {
  active
  revoked
}

enum ModelCatalogType {
  image
  video
  audio
  llm
}

enum MediaType {
  image
  audio
  video
}

enum MediaAssetStatus {
  completed
  deleting
  failed
}

enum MediaAssetOrigin {
  upload
  generation
  media_operation
  legacy_generation
}

enum MediaUploadSessionStatus {
  pending
  confirming
  completed
  expired
  failed
}

enum MediaCleanupTaskStatus {
  uploading
  pending
  processing
  linked
  completed
  failed
}

enum MediaOperationStatus {
  pending
  processing
  uploading
  completed
  failed
  cancelled
}

enum AssistantExecutionStatus {
  pending
  processing
  completed
  failed
  cancelled
}

model ModalComfyJob {
  requestId String @id
  fingerprint String
  jobId String?
  submission Json?
  lease String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImageGeneration {
  id                String                 @id @default(cuid())
  requestId         String                 @unique
  ownerEmail        String?
  apiKeyId          String?
  apiKey            ApiKey?                @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  prompt            String
  requestParams     Json?
  historyMetadata   Json?
  modelKey          String?
  aspectRatio       String?
  imageCount        Int?
  steps             Int?
  seed              String?
  status            ImageGenerationStatus
  progress          Int
  errorMessage      String?
  hiddenAt DateTime?
  createdAt         DateTime               @default(now())
  finishedAt        DateTime?
  updatedAt         DateTime               @updatedAt
  cancelRequestedAt DateTime?
  executionLeaseToken String?
  executionLeaseUntil DateTime?
  executionLeaseVersion Int                   @default(0)
  images            ImageGenerationImage[]
  graphNodeId       String?
  graphNode         GenerationGraphNode?   @relation("GraphNodeGenerations", fields: [graphNodeId], references: [id], onDelete: SetNull)

  @@index([ownerEmail])
  @@index([ownerEmail, createdAt, requestId])
  @@index([ownerEmail, status, createdAt, requestId])
  @@index([createdAt, requestId])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([status, modelKey])
  @@index([apiKeyId, createdAt])
  @@index([graphNodeId, createdAt])
  @@index([status, executionLeaseUntil])
}

model ImageGenerationImage {
  id                   String                @id @default(cuid())
  generationId         String
  url                  String
  width                Int?
  height               Int?
  createdAt            DateTime              @default(now())
  generation           ImageGeneration       @relation(fields: [generationId], references: [id], onDelete: Cascade)
  assetId              String?               @unique
  asset                MediaAsset?           @relation("ImageGenerationAsset", fields: [assetId], references: [id], onDelete: SetNull)

  @@index([generationId])
}

model SpaceEditorPreference {
  inlineParametersEnabled Boolean @default(false)
  ownerEmail      String   @id
  schemaVersion   Int      @default(1)
  revision        Int      @default(0)
  recentModelKeys Json     @default("[]")
  defaults        Json     @default("{}")
  updatedAt       DateTime @updatedAt
}

model GenerationGraph {
  id                   String                @id @default(cuid())
  ownerEmail           String
  title                String
  version              Int                   @default(1)
  schemaVersion        Int                   @default(3)
  minimumWriterVersion Int                   @default(3)
  groups               Json                  @default("[]")
  spaceVersion         Int                   @default(1)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  nodes                GenerationGraphNode[]
  edges                GenerationGraphEdge[]
  mediaOperations      MediaOperation[]
  executionSubmissions NodeExecutionSubmission[]

  @@index([ownerEmail, updatedAt])
}

model GenerationGraphNode {
  id                    String                      @id
  graphId               String
  kind                  String
  x                     Float
  y                     Float
  configVersion         Int
  config                Json
  selectedOutputAssetId String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  graph                 GenerationGraph             @relation(fields: [graphId], references: [id], onDelete: Cascade)
  selectedOutputAsset   MediaAsset?                 @relation("GraphNodeSelectedAsset", fields: [selectedOutputAssetId], references: [id], onDelete: SetNull)
  generations           ImageGeneration[]           @relation("GraphNodeGenerations")
  videoGenerations      VideoGeneration[]           @relation("GraphNodeVideoGenerations")
  audioGenerations      AudioGeneration[]           @relation("GraphNodeAudioGenerations")
  outgoingEdges         GenerationGraphEdge[]       @relation("GraphEdgeSource")
  incomingEdges         GenerationGraphEdge[]       @relation("GraphEdgeTarget")
  mediaOperations       MediaOperation[]
  assistantExecutions   AssistantExecution[]
  executionSubmissions  NodeExecutionSubmission[]
  outputs               GenerationGraphNodeOutput[]

  @@index([graphId])
  @@index([kind])
  @@index([selectedOutputAssetId])
}

model AssistantExecution {
  id                    String                   @id @default(cuid())
  ownerEmail            String
  graphId               String
  graphNodeId           String
  modelKey              String
  inputSnapshot         Json
  status                AssistantExecutionStatus @default(pending)
  outputText            String?
  outputListJson        Json?
  selectedItemId        String?
  selectionVersion      Int                      @default(0)
  errorCode             String?
  executionLeaseToken   String?
  executionLeaseUntil   DateTime?
  executionLeaseVersion Int                      @default(0)
  cancelRequestedAt     DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  finishedAt            DateTime?
  graphNode             GenerationGraphNode      @relation(fields: [graphNodeId], references: [id], onDelete: Cascade)
  inputAssets           AssistantExecutionInputAsset[]

  @@unique([id, ownerEmail])
  @@index([ownerEmail, graphNodeId, createdAt])
  @@index([status, executionLeaseUntil])
  @@index([graphId, graphNodeId, createdAt])
}

model AssistantExecutionInputAsset {
  executionId String
  ownerEmail String
  assetId String
  portId String
  sortOrder Int @default(0)
  execution AssistantExecution @relation(fields: [executionId, ownerEmail], references: [id, ownerEmail], onDelete: Cascade, onUpdate: Restrict)
  asset MediaAsset @relation(fields: [assetId, ownerEmail], references: [id, ownerEmail], onDelete: Restrict, onUpdate: Restrict)

  @@id([executionId, portId, sortOrder])
  @@index([ownerEmail, assetId])
}

model GenerationGraphEdge {
  id           String                   @id
  graphId      String
  sourceNodeId String
  targetNodeId String
  sourcePortId String
  targetPortId String
  sortOrder    Int                      @default(0)
  hasPause     Boolean                  @default(false)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  graph        GenerationGraph          @relation(fields: [graphId], references: [id], onDelete: Cascade)
  sourceNode   GenerationGraphNode      @relation("GraphEdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode   GenerationGraphNode      @relation("GraphEdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([graphId, sourceNodeId, sourcePortId, targetNodeId, targetPortId, sortOrder])
  @@index([graphId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

model VideoGeneration {
  id                String                 @id @default(cuid())
  requestId         String                 @unique
  ownerEmail        String?
  apiKeyId          String?
  apiKey            ApiKey?                @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  prompt            String
  requestParams     Json?
  historyMetadata   Json?
  modelKey          String?
  status            VideoGenerationStatus
  progress          Int
  errorMessage      String?
  hiddenAt DateTime?
  createdAt         DateTime               @default(now())
  finishedAt        DateTime?
  updatedAt         DateTime               @updatedAt
  cancelRequestedAt DateTime?
  executionLeaseToken String?
  executionLeaseUntil DateTime?
  executionLeaseVersion Int                   @default(0)
  videos            VideoGenerationVideo[]
  graphNodeId       String?
  graphNode         GenerationGraphNode?   @relation("GraphNodeVideoGenerations", fields: [graphNodeId], references: [id], onDelete: SetNull)

  @@index([ownerEmail])
  @@index([ownerEmail, createdAt, requestId])
  @@index([ownerEmail, status, createdAt, requestId])
  @@index([createdAt, requestId])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([status, modelKey])
  @@index([apiKeyId, createdAt])
  @@index([graphNodeId, createdAt])
  @@index([status, executionLeaseUntil])
}

model VideoGenerationVideo {
  id           String          @id @default(cuid())
  generationId String
  url          String
  width        Int?
  height       Int?
  durationSec  Int?
  createdAt    DateTime        @default(now())
  generation   VideoGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  assetId      String?         @unique
  asset        MediaAsset?     @relation("VideoGenerationAsset", fields: [assetId], references: [id], onDelete: SetNull)

  @@index([generationId])
}

model AudioGeneration {
  id                String                 @id @default(cuid())
  requestId         String                 @unique
  ownerEmail        String?
  apiKeyId          String?
  apiKey            ApiKey?                @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  prompt            String
  requestParams     Json?
  historyMetadata   Json?
  modelKey          String?
  status            AudioGenerationStatus
  progress          Int
  errorMessage      String?
  hiddenAt DateTime?
  createdAt         DateTime               @default(now())
  finishedAt        DateTime?
  updatedAt         DateTime               @updatedAt
  cancelRequestedAt DateTime?
  executionLeaseToken String?
  executionLeaseUntil DateTime?
  executionLeaseVersion Int                   @default(0)
  audios            AudioGenerationAudio[]
  graphNodeId       String?
  graphNode         GenerationGraphNode?   @relation("GraphNodeAudioGenerations", fields: [graphNodeId], references: [id], onDelete: SetNull)

  @@index([ownerEmail])
  @@index([ownerEmail, createdAt, requestId])
  @@index([ownerEmail, status, createdAt, requestId])
  @@index([createdAt, requestId])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([status, modelKey])
  @@index([apiKeyId, createdAt])
  @@index([graphNodeId, createdAt])
  @@index([status, executionLeaseUntil])
}

model AudioGenerationAudio {
  id           String          @id @default(cuid())
  generationId String
  url          String
  durationSec  Int?
  createdAt    DateTime        @default(now())
  generation   AudioGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  assetId      String?         @unique
  asset        MediaAsset?     @relation("AudioGenerationAsset", fields: [assetId], references: [id], onDelete: SetNull)

  @@index([generationId])
}

model MediaAsset {
  referenceId          String?
  imageVariants        Json?
  displayName          String?
  classification       String?
  displayVersion       String?
  description          String?
  managementStatus     String?
  originalFileName     String?
  folderId             String?
  starred              Boolean @default(false)
  folder               AssetFolder? @relation(fields: [folderId, ownerEmail], references: [id, ownerEmail], onDelete: Restrict, onUpdate: Restrict)
  tagAssignments       AssetTagAssignment[]
  projectMemberships   AssetProjectMembership[]
  coveringProjects     AssetProject[] @relation("AssetProjectCover")
  id                   String                      @id @default(cuid())
  version              Int                         @default(1)
  ownerEmail           String
  type                 MediaType
  status               MediaAssetStatus            @default(completed)
  origin               MediaAssetOrigin
  storageProvider      String
  storageObjectId      String
  storageUrl           String?
  legacyUrl            String?
  mimeType             String
  bytes                BigInt?
  width                Int?
  height               Int?
  durationMs           Int?
  sourceOperationId    String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  sourceOperation      MediaOperation?             @relation("MediaOperationOutputs", fields: [sourceOperationId], references: [id], onDelete: SetNull)
  selectedByGraphNodes GenerationGraphNode[]       @relation("GraphNodeSelectedAsset")
  graphNodeOutputs     GenerationGraphNodeOutput[]
  operationOutputBindings MediaOperationOutput[]
  operationInputs      MediaOperationInput[]
  uploadSessions       MediaUploadSession[]
  generationInputAssets GenerationInputAsset[]
  assistantInputAssets AssistantExecutionInputAsset[]
  imageGenerationImage ImageGenerationImage?       @relation("ImageGenerationAsset")
  videoGenerationVideo VideoGenerationVideo?       @relation("VideoGenerationAsset")
  audioGenerationAudio AudioGenerationAudio?       @relation("AudioGenerationAsset")
  cleanupTasks         MediaCleanupTask[]

  @@unique([id, ownerEmail])
  @@unique([ownerEmail, referenceId])
  @@unique([storageProvider, storageObjectId])
  @@index([ownerEmail, folderId, status, createdAt, id])
  @@index([ownerEmail, starred, status, createdAt, id])
  @@index([ownerEmail, type, status, createdAt])
  @@index([sourceOperationId])
}

model AssetProject {
  id String @id @default(cuid())
  ownerEmail String
  name String
  normalizedName String
  description String @default("")
  version Int @default(1)
  parentId String?
  parentKey String @default("root")
  coverAssetId String?
  parent AssetProject? @relation("AssetProjectChildren", fields: [parentId, ownerEmail], references: [id, ownerEmail], onDelete: Restrict, onUpdate: Restrict)
  children AssetProject[] @relation("AssetProjectChildren")
  coverAsset MediaAsset? @relation("AssetProjectCover", fields: [coverAssetId, ownerEmail], references: [id, ownerEmail], onDelete: Restrict, onUpdate: Restrict)
  memberships AssetProjectMembership[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, ownerEmail])
  @@unique([ownerEmail, parentKey, normalizedName])
  @@index([ownerEmail, parentId])
  @@index([ownerEmail, coverAssetId])
}

model AssetProjectMembership {
  assetId String
  projectId String
  ownerEmail String
  asset MediaAsset @relation(fields: [assetId, ownerEmail], references: [id, ownerEmail], onDelete: Cascade, onUpdate: Restrict)
  project AssetProject @relation(fields: [projectId, ownerEmail], references: [id, ownerEmail], onDelete: Cascade, onUpdate: Restrict)
  createdAt DateTime @default(now())

  @@id([assetId, projectId])
  @@index([ownerEmail, projectId, assetId])
}

model AssetFolder {
  id String @id @default(cuid())
  ownerEmail String
  name String
  normalizedName String
  version Int @default(1)
  parentId String?
  parentKey String @default("root")
  parent AssetFolder? @relation("AssetFolderChildren", fields: [parentId, ownerEmail], references: [id, ownerEmail], onDelete: Restrict, onUpdate: Restrict)
  children AssetFolder[] @relation("AssetFolderChildren")
  assets MediaAsset[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, ownerEmail])
  @@unique([ownerEmail, parentKey, normalizedName])
  @@index([ownerEmail, parentId])
}

model AssetTag {
  id String @id @default(cuid())
  ownerEmail String
  name String
  normalizedName String
  version Int @default(1)
  assignments AssetTagAssignment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, ownerEmail])
  @@unique([ownerEmail, normalizedName])
}

model AssetTagAssignment {
  assetId String
  tagId String
  ownerEmail String
  asset MediaAsset @relation(fields: [assetId, ownerEmail], references: [id, ownerEmail], onDelete: Cascade, onUpdate: Restrict)
  tag AssetTag @relation(fields: [tagId, ownerEmail], references: [id, ownerEmail], onDelete: Cascade, onUpdate: Restrict)
  createdAt DateTime @default(now())

  @@id([assetId, tagId])
  @@index([ownerEmail, tagId, assetId])
}

// A generation keeps a durable, owner-scoped reference to every uploaded
// input. The polymorphic requestId keeps this small feature independent from
// the three generation tables while the FK protects source assets from an
// early delete.
model GenerationInputAsset {
  id             String    @id @default(cuid())
  requestId      String
  generationType MediaType
  ownerEmail     String
  field          String
  sortOrder      Int       @default(0)
  multiple       Boolean   @default(false)
  assetId        String
  createdAt      DateTime  @default(now())
  asset          MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([requestId, generationType, field, sortOrder])
  @@index([assetId])
  @@index([ownerEmail, generationType, requestId])
}

model MediaUploadSession {
  id                String                   @id @default(cuid())
  ownerEmail        String
  intendedType      MediaType
  fileName          String
  declaredMimeType  String
  declaredBytes     BigInt
  storageProvider   String
  storageObjectId   String                   @unique
  storageObjectName String
  storageFileName   String?
  storageUrl        String
  operationId       String?
  outputPortId      String?
  sortOrder         Int                      @default(0)
  status            MediaUploadSessionStatus @default(pending)
  expiresAt         DateTime
  assetId           String?                  @unique
  errorCode         String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  operation         MediaOperation?          @relation(fields: [operationId], references: [id], onDelete: SetNull)
  asset             MediaAsset?              @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([ownerEmail, status, expiresAt])
  @@index([operationId])
  @@index([assetId])
}

/// Durable storage deletion intent. The row is written before remote upload
/// work and is linked to the MediaAsset in the same transaction as the asset.
/// That makes process crashes converge without deleting a valid referenced
/// asset.
model MediaCleanupTask {
  id                String                 @id @default(cuid())
  ownerEmail        String?
  requestId         String?
  storageProvider   String
  storageObjectId   String
  storageUrl        String?
  reason            String
  assetId           String?
  status            MediaCleanupTaskStatus @default(uploading)
  attempts          Int                    @default(0)
  queueRevision     Int                    @default(0)
  retryAt           DateTime
  leaseToken        String?
  leaseUntil        DateTime?
  lastError         String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  asset             MediaAsset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([storageProvider, storageObjectId])
  @@index([status, retryAt])
  @@index([requestId, status])
  @@index([assetId, status])
}

model GenerationGraphNodeOutput {
  id          String              @id @default(cuid())
  graphNodeId String
  portId      String
  assetId     String
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  graphNode   GenerationGraphNode @relation(fields: [graphNodeId], references: [id], onDelete: Cascade)
  asset       MediaAsset          @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([graphNodeId, portId, sortOrder])
  @@index([assetId])
}

model MediaOperation {
  id                  String                @id @default(cuid())
  ownerEmail          String
  graphId             String?
  graphNodeId         String?
  type                String
  configVersion       Int
  parameters          Json
  status              MediaOperationStatus  @default(pending)
  progress            Int                   @default(0)
  expectedOutputCount Int                   @default(1)
  errorCode           String?
  errorMessage        String?
  executionLeaseToken String?
  executionLeaseUntil DateTime?
  executionLeaseVersion Int                 @default(0)
  hiddenAt DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  finishedAt          DateTime?
  graph               GenerationGraph?      @relation(fields: [graphId], references: [id], onDelete: SetNull)
  graphNode           GenerationGraphNode?  @relation(fields: [graphNodeId], references: [id], onDelete: SetNull)
  inputs              MediaOperationInput[]
  outputs             MediaAsset[]          @relation("MediaOperationOutputs")
  outputBindings      MediaOperationOutput[]
  uploadSessions      MediaUploadSession[]

  @@index([ownerEmail, status, createdAt])
  @@index([createdAt, id])
  @@index([graphId, graphNodeId, createdAt])
  @@index([status, executionLeaseUntil])
}

model PromptPreset {
  id                    String    @id @default(cuid())
  ownerEmail            String
  key                   String
  builtinKey            String?
  name                  String
  description           String    @default("")
  modality              MediaType
  prompt                String?
  requiredInputs        Json      @default("{}")
  recommendedParameters Json      @default("{}")
  deletedAt             DateTime?
  isActive              Boolean   @default(true)
  revision              Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([ownerEmail, key])
  @@index([ownerEmail, modality, isActive])
}

model MediaOperationOutput {
  id          String         @id @default(cuid())
  operationId String
  portId      String
  sortOrder   Int            @default(0)
  assetId     String?
  operation   MediaOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  asset       MediaAsset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@unique([operationId, portId, sortOrder])
  @@index([assetId])
}

model MediaOperationInput {
  id          String         @id @default(cuid())
  operationId String
  assetId     String
  portId      String
  sortOrder   Int            @default(0)
  operation   MediaOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  asset       MediaAsset     @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([operationId, portId, sortOrder])
  @@index([assetId])
}

model ModelCatalog {
  id             String           @id @default(cuid())
  type           ModelCatalogType
  key            String           @unique
  label          String
  vendor         String
  provider       String
  providerConfig Json
  parameters     Json
  meta           Json
  isActive       Boolean          @default(true)
  isDefault      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  credential     ModelCredential?

  @@index([type, isActive])
  @@index([type, isDefault])
}

model ModelCredential {
  id         String       @id @default(cuid())
  modelId    String       @unique
  ciphertext String
  iv         String
  tag        String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  model      ModelCatalog @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id               String            @id @default(cuid())
  ownerEmail       String
  label            String
  keyHash          String            @unique
  maskedKey        String
  permissions      Json              @default("[]")
  status           ApiKeyStatus      @default(active)
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  imageGenerations ImageGeneration[]
  videoGenerations VideoGeneration[]
  audioGenerations AudioGeneration[]

  @@index([ownerEmail])
  @@index([status])
}
/// Shared admission state for rate limiting. One row per bucket key so every
/// process and instance consumes the same budget.
model RateLimitBucket {
  key       String   @id
  tokens    Float
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([expiresAt])
}
/// Durable admission ledger for generation submissions.
///
/// The row exists before any uploaded file or provider call, so a retry can be
/// answered with the same request id and a crashed preparation can be reclaimed
/// instead of starting a second paid job.
model GenerationSubmission {
  id              String   @id @default(uuid())
  requestId       String   @unique
  ownerEmail      String
  apiKeyId        String?
  scope           String
  idempotencyHash String?
  payloadHash     String
  providerKey     String?
  graphNodeId     String?
  state           String   @default("preparing")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime

  @@unique([scope, idempotencyHash])
  @@index([ownerEmail, state])
  @@index([providerKey, state])
  @@index([state, expiresAt])
}

/// Committed atomically with one external node execution. No raw API/idempotency keys.
model NodeExecutionSubmission {
  id              String @id @default(uuid())
  ownerEmail      String
  apiKeyId        String
  graphId         String
  nodeId          String
  idempotencyHash String?
  requestHash     String
  executionId     String @unique
  nodeKind        String
  inputSnapshot   Json
  createdAt       DateTime @default(now())
  graph           GenerationGraph @relation(fields: [graphId], references: [id], onDelete: Cascade)
  node            GenerationGraphNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([ownerEmail, apiKeyId, graphId, nodeId, idempotencyHash], map: "NodeExecutionSubmission_scope_key")
  @@index([graphId, nodeId])
  @@index([nodeId])
}

enum QueueJobKind {
  generate_image
  generate_video
  generate_audio
  media_operation
  assistant
  storage_cleanup
}

enum QueueSourceType {
  image_generation
  video_generation
  audio_generation
  media_operation
  assistant_execution
  storage_cleanup
}

enum QueueJobStatus {
  suspended
  ready
  retry_wait
  active
  succeeded
  dead_letter
  reconciliation_required
  cancelled
  abandoned
}

enum QueueRuntimeMode {
  paused
  shared
}

enum QueueAttemptPhase {
  claimed
  remote_started
  settling
  ended
}

enum QueueAttemptOutcome {
  succeeded
  failed
  cancelled
  retrying
  protected
  reconciliation_required
}

enum QueueReservationDisposition {
  held
  uncertain
}

enum QueueDeadLetterClassification {
  terminal
  reconciliation
}

enum QueueDeadLetterState {
  open
  redriven
  resolved
  abandoned
}

model QueueRuntime {
  id                Int              @id @default(1)
  mode              QueueRuntimeMode @default(paused)
  epoch             Int              @default(1)
  nextKindCursor    Int              @default(0)
  migrationCursor   Json             @default("{}")
  migrationVerified Boolean          @default(false)
  updatedAt         DateTime         @default(now()) @updatedAt
}

model QueueOrderGroup {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerScopeDigest String
  opaqueKey        String
  nextSequence     BigInt     @default(1)
  headSequence     BigInt     @default(1)
  blockedByJobId   String?    @unique @db.Uuid
  closedAt         DateTime?
  version          Int        @default(0)
  createdAt        DateTime   @default(now())
  jobs             QueueJob[] @relation("OrderedJobs")
  blockedByJob     QueueJob?  @relation("GroupBlocker", fields: [blockedByJobId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([ownerScopeDigest, opaqueKey])
  @@unique([id, ownerScopeDigest])
}

model QueueJob {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind             QueueJobKind
  sourceType       QueueSourceType
  sourceId         String
  sourceRevision   Int             @default(0)
  snapshotRef      String
  ownerScopeDigest String
  executionType    QueueSourceType
  executionId      String
  orderGroupId     String?         @db.Uuid
  sequence         BigInt?
  status           QueueJobStatus  @default(ready)
  availableAt      DateTime        @default(now())
  maxAttempts      Int             @default(1)
  retryDelayMs     Int             @default(0)
  policyVersion    Int             @default(1)
  cycle            Int             @default(1)
  version          Int             @default(0)
  cancelRequestedAt DateTime?
  currentAttemptId String?         @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  orderGroup       QueueOrderGroup? @relation("OrderedJobs", fields: [orderGroupId, ownerScopeDigest], references: [id, ownerScopeDigest], onDelete: Restrict, onUpdate: NoAction)
  blockingGroup    QueueOrderGroup? @relation("GroupBlocker")
  attempts         QueueAttempt[]  @relation("JobAttempts")
  currentAttempt   QueueAttempt?   @relation("CurrentAttempt", fields: [id, currentAttemptId], references: [jobId, id], onDelete: NoAction, onUpdate: NoAction)
  resources        QueueJobResource[]
  deadLetters      QueueDeadLetter[]
  adminActions     QueueAdminAction[]

  @@unique([kind, sourceType, sourceId, sourceRevision], map: "QueueJob_source_identity")
  @@unique([orderGroupId, sequence])
  @@unique([id, currentAttemptId])
  @@index([kind, status, availableAt, createdAt, id])
  @@index([ownerScopeDigest, createdAt, id])
}

model QueueAttempt {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId             String              @db.Uuid
  lifetimeOrdinal   Int
  cycle             Int
  cycleOrdinal      Int
  executionType     QueueSourceType
  executionId       String
  workerInstanceId  String              @db.Uuid
  leaseToken        String              @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaseVersion      Int
  leaseUntil        DateTime
  heartbeatAt       DateTime            @default(now())
  runtimeEpoch      Int
  phase             QueueAttemptPhase   @default(claimed)
  outcome           QueueAttemptOutcome?
  remoteEvidenceRef String?
  startedAt         DateTime            @default(now())
  finishedAt        DateTime?
  job               QueueJob            @relation("JobAttempts", fields: [jobId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  currentForJob     QueueJob?            @relation("CurrentAttempt")
  reservations      QueueReservation[]
  deadLetter        QueueDeadLetter?

  @@unique([jobId, lifetimeOrdinal])
  @@unique([jobId, cycle, cycleOrdinal])
  @@unique([jobId, id])
  @@index([finishedAt, leaseUntil])
}

model QueueResource {
  key            String  @id
  staticCapacity Int?
  modelType      ModelCatalogType?
  modelKey       String?
  requirements   QueueJobResource[]
  reservations   QueueReservation[]
}

model QueueJobResource {
  jobId       String        @db.Uuid
  resourceKey String
  job         QueueJob      @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  resource    QueueResource @relation(fields: [resourceKey], references: [key], onDelete: Restrict, onUpdate: NoAction)

  @@id([jobId, resourceKey])
  @@index([resourceKey])
}

model QueueReservation {
  attemptId   String                      @db.Uuid
  resourceKey String
  disposition QueueReservationDisposition @default(held)
  createdAt   DateTime                    @default(now())
  releasedAt  DateTime?
  attempt     QueueAttempt                @relation(fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  resource    QueueResource               @relation(fields: [resourceKey], references: [key], onDelete: Restrict, onUpdate: NoAction)

  @@id([attemptId, resourceKey])
  @@index([resourceKey, releasedAt])
}

model QueueDeadLetter {
  id               String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId            String                        @db.Uuid
  failedAttemptId  String                        @unique @db.Uuid
  classification   QueueDeadLetterClassification
  state            QueueDeadLetterState          @default(open)
  safeErrorCode    String
  phase            String
  detail           Json?
  createdAt        DateTime                      @default(now())
  resolvedAt       DateTime?
  detailPurgedAt   DateTime?
  version          Int                           @default(0)
  job              QueueJob                      @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  failedAttempt    QueueAttempt                  @relation(fields: [jobId, failedAttemptId], references: [jobId, id], onDelete: Restrict, onUpdate: NoAction)
  actions          QueueAdminAction[]

  @@unique([jobId, failedAttemptId])
  @@index([state, classification, createdAt, id])
}

model QueueAdminAction {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId          String           @unique
  requestFingerprint String
  actorDigest        String
  action             String
  jobId              String?          @db.Uuid
  deadLetterId       String?          @db.Uuid
  expectedVersion    Int?
  safeReason         String
  before             Json?
  after              Json?
  outcome            String
  createdAt          DateTime         @default(now())
  job                QueueJob?        @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  deadLetter         QueueDeadLetter?  @relation(fields: [deadLetterId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([jobId, createdAt, id])
}
