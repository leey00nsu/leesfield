generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum ImageGenerationStatus {
  pending
  processing
  completed
  failed
}

enum VideoGenerationStatus {
  pending
  processing
  completed
  failed
}

enum ApiKeyStatus {
  active
  revoked
}

model ImageGeneration {
  id             String                 @id @default(cuid())
  requestId      String                 @unique
  ownerEmail     String?
  prompt         String
  requestParams  Json?
  aspectRatio    String
  imageCount     Int
  steps          Int
  seed           String?
  status         ImageGenerationStatus
  progress       Int
  errorMessage   String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  images         ImageGenerationImage[]

  @@index([ownerEmail])
}

model ImageGenerationImage {
  id           String          @id @default(cuid())
  generationId String
  url          String
  width        Int?
  height       Int?
  createdAt    DateTime        @default(now())
  generation   ImageGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([generationId])
}

model VideoGeneration {
  id            String               @id @default(cuid())
  requestId     String               @unique
  ownerEmail    String?
  prompt        String
  requestParams Json?
  status        VideoGenerationStatus
  progress      Int
  errorMessage  String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  videos        VideoGenerationVideo[]

  @@index([ownerEmail])
}

model VideoGenerationVideo {
  id           String          @id @default(cuid())
  generationId String
  url          String
  width        Int?
  height       Int?
  durationSec  Int?
  createdAt    DateTime        @default(now())
  generation   VideoGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([generationId])
}

model ApiKey {
  id         String       @id @default(cuid())
  ownerEmail String
  label      String
  keyHash    String       @unique
  maskedKey  String
  status     ApiKeyStatus @default(active)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([ownerEmail])
  @@index([status])
}
