// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ImageGenerationStatus {
  pending
  processing
  completed
  failed
}

enum VideoGenerationStatus {
  pending
  processing
  completed
  failed
}

enum ApiKeyStatus {
  active
  revoked
}

enum ModelCatalogType {
  image
  video
}

model ImageGeneration {
  id             String                 @id @default(cuid())
  requestId      String                 @unique
  ownerEmail     String?
  apiKeyId       String?
  apiKey         ApiKey?                @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  prompt         String
  requestParams  Json?
  modelKey       String?
  aspectRatio    String
  imageCount     Int
  steps          Int
  seed           String?
  status         ImageGenerationStatus
  progress       Int
  errorMessage   String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  images         ImageGenerationImage[]

  @@index([ownerEmail])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([status, modelKey])
  @@index([apiKeyId, createdAt])
}

model ImageGenerationImage {
  id           String          @id @default(cuid())
  generationId String
  url          String
  width        Int?
  height       Int?
  createdAt    DateTime        @default(now())
  generation   ImageGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([generationId])
}

model VideoGeneration {
  id            String               @id @default(cuid())
  requestId     String               @unique
  ownerEmail    String?
  apiKeyId      String?
  apiKey        ApiKey?              @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  prompt        String
  requestParams Json?
  modelKey      String?
  status        VideoGenerationStatus
  progress      Int
  errorMessage  String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  videos        VideoGenerationVideo[]

  @@index([ownerEmail])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([status, modelKey])
  @@index([apiKeyId, createdAt])
}

model VideoGenerationVideo {
  id           String          @id @default(cuid())
  generationId String
  url          String
  width        Int?
  height       Int?
  durationSec  Int?
  createdAt    DateTime        @default(now())
  generation   VideoGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([generationId])
}

model ModelCatalog {
  id             String           @id @default(cuid())
  type           ModelCatalogType
  key            String           @unique
  label          String
  vendor         String
  provider       String
  providerConfig Json
  parameters     Json
  meta           Json
  isActive       Boolean          @default(true)
  isDefault      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([type, isActive])
  @@index([type, isDefault])
}

model ApiKey {
  id         String       @id @default(cuid())
  ownerEmail String
  label      String
  keyHash    String       @unique
  maskedKey  String
  status     ApiKeyStatus @default(active)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  imageGenerations ImageGeneration[]
  videoGenerations VideoGeneration[]

  @@index([ownerEmail])
  @@index([status])
}
