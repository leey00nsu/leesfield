POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=leesfield
POSTGRES_USER=leesfield
POSTGRES_PASSWORD=leesfield

DATABASE_URL=postgresql://leesfield:leesfield@localhost:5432/leesfield?schema=public

ADMIN_EMAIL=admin@example.com
# bcrypt 해시 값 (pnpm gen:admin-password-hash로 생성, $는 \\$로 이스케이프)
ADMIN_PASSWORD_HASH=
# SESSION_PASSWORD는 32자 이상이어야 합니다.
SESSION_PASSWORD=change-me-change-me-change-me-change-me

# Leemage 저장소 설정
LEEMAGE_API_KEY=
LEEMAGE_PROJECT_ID=
LEEMAGE_STORAGE_PROVIDER=OCI
# LEEMAGE_BASE_URL=

# MODAL
# MODAL_TOKEN_ID / MODAL_TOKEN_SECRET: `modal token new` 실행 또는 `modal token set`으로 발급
# MODAL_PROXY_KEY / MODAL_PROXY_SECRET: Modal 대시보드 → Workspace Settings → Tokens → Proxy Auth Tokens에서 발급
MODAL_IMAGE_ENDPOINT=
MODAL_VIDEO_ENDPOINT=
MODAL_TIMEOUT_MS=120000
NEXT_PUBLIC_MODAL_TIMEOUT_MS=120000
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=

# Hugging Face
HUGGINGFACE_HUB_TOKEN=
HF_TOKEN=

# Video model IDs (Diffusers)
HUNYUANVIDEO_T2V_MODEL_ID=hunyuanvideo-community/HunyuanVideo-1.5-480p_t2v
VIDEO_ENABLE_CPU_OFFLOAD=1
VIDEO_ENABLE_SEQUENTIAL_CPU_OFFLOAD=0
