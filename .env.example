# ==============================================================================
# leesfield 환경 설정
# 이 파일을 .env로 복사한 후 값을 채워주세요: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 데이터베이스 (PostgreSQL)
# Docker Compose로 로컬 DB를 실행하거나 외부 DB를 사용할 수 있습니다.
# ------------------------------------------------------------------------------

# DB 호스트
POSTGRES_HOST=localhost

# DB 포트
POSTGRES_PORT=5432

# 데이터베이스명
POSTGRES_DB=leesfield

# DB 사용자
POSTGRES_USER=leesfield

# DB 비밀번호
POSTGRES_PASSWORD=leesfield

# Prisma 연결 URL
# 형식: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://leesfield:leesfield@localhost:5432/leesfield?schema=public

# ------------------------------------------------------------------------------
# 관리자 인증
# ------------------------------------------------------------------------------

# 관리자 이메일
ADMIN_EMAIL=admin@example.com

# 비밀번호 해시 (bcrypt → base64url 인코딩)
# 생성 방법: pnpm gen:admin-password-hash
ADMIN_PASSWORD_HASH=

# 세션 암호화 비밀번호 (32자 이상 필수)
SESSION_PASSWORD=change-me-change-me-change-me-change-me

# ------------------------------------------------------------------------------
# 저장소 설정 (Leemage)
# 결과 저장을 사용하려면 아래 값을 채워야 합니다.
# ------------------------------------------------------------------------------

# 이미지 저장 어댑터 선택 (기본: leemage)
IMAGE_STORAGE_PROVIDER=leemage

# 비디오 저장 어댑터 선택 (기본: leemage)
VIDEO_STORAGE_PROVIDER=leemage

# Leemage 업로드용 API 키
LEEMAGE_API_KEY=

# Leemage 프로젝트 ID
LEEMAGE_PROJECT_ID=

# 커스텀 API 엔드포인트 (선택)
# LEEMAGE_BASE_URL=

# ------------------------------------------------------------------------------
# 클라이언트 설정
# ------------------------------------------------------------------------------

# 프론트 폴링 타임아웃(ms)
NEXT_PUBLIC_IMAGE_TIMEOUT_MS=300000
NEXT_PUBLIC_VIDEO_TIMEOUT_MS=300000

# API 문서 예시 요청 Base URL (선택)
NEXT_PUBLIC_API_BASE_URL=

# ------------------------------------------------------------------------------
# Hugging Face Space (Gradio API)
# 모델 카탈로그에서 사용하는 Space에 접근하려면 토큰을 설정하세요.
# ------------------------------------------------------------------------------

# Hugging Face Access Token
HF_TOKEN=
