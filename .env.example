POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=leesfield
POSTGRES_USER=leesfield
POSTGRES_PASSWORD=leesfield

DATABASE_URL=postgresql://leesfield:leesfield@localhost:5432/leesfield?schema=public

ADMIN_EMAIL=admin@example.com
# bcrypt 해시 값 (pnpm gen:admin-password-hash로 생성, $는 \\$로 이스케이프)
ADMIN_PASSWORD_HASH=
# SESSION_PASSWORD는 32자 이상이어야 합니다.
SESSION_PASSWORD=change-me-change-me-change-me-change-me

# Leemage 저장소 설정
LEEMAGE_API_KEY=
LEEMAGE_PROJECT_ID=
LEEMAGE_STORAGE_PROVIDER=OCI
# LEEMAGE_BASE_URL=

# External API provider
# IMAGE_PROVIDER / VIDEO_PROVIDER: hf_space
IMAGE_PROVIDER=hf_space
VIDEO_PROVIDER=hf_space

# 클라이언트 타임아웃(폴링 기준)
NEXT_PUBLIC_IMAGE_TIMEOUT_MS=120000
NEXT_PUBLIC_VIDEO_TIMEOUT_MS=120000

# Hugging Face Space (Gradio API)
HF_TOKEN=

# Image Space (Z-Image Turbo)
HF_IMAGE_SPACE_ID=leey00nsu/Z-Image-Turbo
HF_IMAGE_SPACE_API_NAME=/generate_image
HF_IMAGE_SPACE_TIMEOUT_MS=300000
HF_IMAGE_SPACE_URL=

# Video Space (Wan 2.2)
HF_VIDEO_SPACE_ID=leey00nsu/wan2-2-fp8da-aoti-faster
HF_VIDEO_SPACE_API_NAME=/generate_video
HF_VIDEO_SPACE_TIMEOUT_MS=300000
HF_VIDEO_SPACE_URL=
