# ==============================================================================
# leesfield 환경 설정
# 이 파일을 .env로 복사한 후 값을 채워주세요: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 데이터베이스 (PostgreSQL)
# Docker Compose로 로컬 DB를 실행하거나 외부 DB를 사용할 수 있습니다.
# ------------------------------------------------------------------------------

# DB 호스트
POSTGRES_HOST=localhost

# DB 포트
POSTGRES_PORT=5432

# 데이터베이스명
POSTGRES_DB=leesfield

# DB 사용자
POSTGRES_USER=leesfield

# DB 비밀번호
POSTGRES_PASSWORD=leesfield

# Prisma 연결 URL
# 형식: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://leesfield:leesfield@localhost:5432/leesfield?schema=public

# DB 연결/대기 예산 (선택, 주석 처리된 값이 기본값)
# 연결 pool 크기 (1-50)
# DB_POOL_MAX=10
# pool에서 연결을 얻기까지 기다리는 시간 (100-60000ms)
# DB_ACQUIRE_TIMEOUT_MS=2000
# 유휴 연결을 닫기까지의 시간 (1000-600000ms)
# DB_IDLE_TIMEOUT_MS=30000
# 단일 statement 상한 (1000-300000ms)
# DB_STATEMENT_TIMEOUT_MS=10000
# 잠금 대기 상한 (100-60000ms)
# DB_LOCK_TIMEOUT_MS=2000
# interactive transaction 상한 (1000-300000ms, DB_ACQUIRE_TIMEOUT_MS 이상)
# DB_TRANSACTION_TIMEOUT_MS=5000
# 이벤트 LISTEN 연결 수립 상한 (500-60000ms)
# PG_LISTENER_CONNECT_TIMEOUT_MS=2000

# ------------------------------------------------------------------------------
# 관리자 인증
# ------------------------------------------------------------------------------

# 관리자 이메일
ADMIN_EMAIL=admin@example.com

# 비밀번호 해시 (bcrypt → base64url 인코딩)
# 생성 방법: pnpm gen:admin-password-hash
ADMIN_PASSWORD_HASH=

# 세션 암호화 비밀번호 (32자 이상 필수)
SESSION_PASSWORD=change-me-change-me-change-me-change-me

# 로컬 개발 로그인 우회 (NODE_ENV=development에서만 동작)
# 운영 환경에서는 true로 설정해도 무시됩니다.
DEV_AUTH_BYPASS=false

# 서비스 공개 origin (운영 필수, 예: https://studio.example.com)
# 세션 쿠키로 들어오는 변경 요청(POST/PATCH/DELETE)은 이 origin 또는 요청 Host와 일치해야 합니다.
# APP_ORIGIN=https://studio.example.com

# 신뢰 프록시 설정 (기본 false)
# true로 켜면 X-Forwarded-For의 오른쪽 TRUSTED_PROXY_HOPS 항목을 클라이언트 주소로 사용합니다.
# 직접 접속이 차단된 프록시 뒤에서만 켜세요. 켜지 않으면 모든 요청이 공용 버킷으로 계산됩니다.
# TRUST_PROXY_HEADERS=false
# TRUSTED_PROXY_HOPS=1

# 우회 로그인 이메일 (선택, 미설정 시 ADMIN_EMAIL 사용)
DEV_AUTH_BYPASS_EMAIL=

# ------------------------------------------------------------------------------
# 저장소 설정 (Leemage)
# 결과 저장을 사용하려면 아래 값을 채워야 합니다.
# ------------------------------------------------------------------------------

# 이미지 저장 어댑터 선택 (기본: leemage)
IMAGE_STORAGE_PROVIDER=leemage

# 비디오 저장 어댑터 선택 (기본: leemage)
VIDEO_STORAGE_PROVIDER=leemage

# 오디오 저장 어댑터 선택 (기본: leemage)
AUDIO_STORAGE_PROVIDER=leemage

# Leemage 업로드용 API 키
LEEMAGE_API_KEY=

# Leemage 프로젝트 ID
LEEMAGE_PROJECT_ID=

# 커스텀 API 엔드포인트 (선택)
# LEEMAGE_BASE_URL=

# ------------------------------------------------------------------------------
# 클라이언트 설정
# ------------------------------------------------------------------------------

# 프론트 폴링 타임아웃(ms)
NEXT_PUBLIC_IMAGE_TIMEOUT_MS=300000
NEXT_PUBLIC_VIDEO_TIMEOUT_MS=300000

# API 문서 예시 요청 Base URL (선택)
NEXT_PUBLIC_API_BASE_URL=

# ------------------------------------------------------------------------------
# Hugging Face Space (Gradio API)
# 모델 카탈로그에서 사용하는 Space에 접근하려면 토큰을 설정하세요.
# ------------------------------------------------------------------------------

# Hugging Face Access Token
HF_TOKEN=

# ------------------------------------------------------------------------------
# Codex CLI 이미지 생성 (GPT Image 2)
# 서버에서 codex CLI가 설치되어 있고 `codex login`으로 ChatGPT OAuth 로그인이 되어 있어야 합니다.
# 별도 OpenAI API key를 이 앱에 저장하지 않습니다.
# 기본 ~/.codex가 아닌 인증 디렉터리를 사용할 때만 CODEX_HOME을 지정하세요.
# ------------------------------------------------------------------------------

# Codex CLI 인증 홈 (선택)
# CODEX_HOME=

# ------------------------------------------------------------------------------
# Codex Image Bridge 이미지 생성 (GPT Image 2)
# 메인 앱 컨테이너에 Codex CLI/OAuth를 넣지 않고 별도 codex-image-bridge 서비스로 위임할 때 사용합니다.
# CODEX_IMAGE_BRIDGE_TOKEN은 bridge 서비스의 CODEX_BRIDGE_TOKEN과 같은 값이어야 합니다.
# public proxy timeout을 피하기 위해 앱은 bridge async job API를 polling합니다.
# ------------------------------------------------------------------------------

# Codex image bridge origin/root URL, path 제외 (예: http://codex-image-bridge-xxxxx:18080)
CODEX_IMAGE_BRIDGE_URL=

# Codex image bridge bearer token
CODEX_IMAGE_BRIDGE_TOKEN=

# Bridge 호출 timeout은 모델 카탈로그 provider_config.timeout_ms에서 관리합니다.

# Modal managed image/video workflows (server only)
MODAL_COMFY_URL=
MODAL_COMFY_API_KEY=
