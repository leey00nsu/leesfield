# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/storybook-static
# Browser traces may contain authenticated requests or presigned storage URLs.
/artifacts/node-banana-e2e/test-results/
# Generated review evidence/reports stay local; fixed snapshots remain trackable.
/artifacts/node-banana-e2e/evidence/
/artifacts/node-banana-e2e/results.json
/tmp/

# next.js
/.next/
/.next-node-studio-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# python
__pycache__/
*.py[cod]

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# generated from the immutable Node Banana snapshot + Leesfield patches
/.generated/
