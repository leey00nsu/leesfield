{
  "name": "leesfield-fe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-auth-env.mjs && pnpm db:prepare",
    "dev": "next dev",
    "prebuild": "pnpm db:generate",
    "build": "next build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "start": "next start",
    "lint": "eslint",
    "security:production": "pnpm audit --prod --audit-level high",
    "pretypecheck": "pnpm db:generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:production-integration": "node scripts/production/test-production-integration.mjs",
    "verify": "node scripts/verification/run.mjs",
    "verify:plan": "node scripts/verification/run.mjs --plan",
    "verify:full": "node scripts/verification/run.mjs --full",
    "load:stub-smoke": "node scripts/load/stub-smoke.mjs",
    "e2e:spaces": "playwright test --config=playwright.spaces.config.mjs",
    "e2e:spaces:isolated": "node scripts/spaces/run-e2e.mjs",
    "dependencies:check": "node scripts/spaces/verify-dependencies.mjs",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:indexes:history": "node --env-file-if-exists=.env scripts/production/create-history-search-indexes.mjs",
    "db:prepare": "pnpm db:generate && pnpm db:migrate:deploy",
    "release:migrate": "node --env-file-if-exists=.env scripts/check-auth-env.mjs && pnpm db:generate && pnpm db:migrate:deploy && pnpm db:indexes:history",
    "db:backup": "node --env-file-if-exists=.env scripts/production/backup-db.mjs",
    "db:restore": "node --env-file-if-exists=.env scripts/production/restore-db.mjs",
    "db:verify-restore": "node --env-file-if-exists=.env scripts/production/verify-restore.mjs",
    "queue:transition": "node --env-file-if-exists=.env scripts/production/job-queue-transition.mjs",
    "queue:bootstrap": "node --env-file-if-exists=.env scripts/production/job-queue-bootstrap.mjs",
    "db:seed:model-catalog": "node scripts/seed-model-catalog.mjs",
    "gen:admin-password-hash": "node scripts/generate-admin-password-hash.mjs",
    "license:check": "node scripts/security/verify-licenses.mjs",
    "vulnerability:check": "pnpm security:production",
    "prepare": "husky",
    "test:storage-contract:isolated": "node scripts/spaces/run-e2e.mjs --storage-contract",
    "verify:quick": "node scripts/verification/quick.mjs",
    "verify:release": "node scripts/verification/run.mjs --release",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "e2e:spaces:production": "node scripts/spaces/run-production-smoke.mjs",
    "e2e:spaces:core": "node scripts/spaces/run-e2e.mjs --core"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.0",
    "@base-ui/react": "1.7.0",
    "@gradio/client": "^2.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@paper-design/shaders-react": "^0.0.76",
    "@prisma/adapter-pg": "^6.0.0",
    "@prisma/client": "^6.0.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@shikijs/transformers": "^4.4.3",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "12.11.3",
    "ajv": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "file-type": "^22.1.0",
    "framer-motion": "^12.38.0",
    "iron-session": "^8.0.4",
    "jszip": "3.10.1",
    "leemage-sdk": "^0.2.0",
    "lucide-react": "^0.562.0",
    "mediabunny": "1.31.0",
    "motion": "^12.38.0",
    "next": "16.4.1",
    "next-intl": "4.14.5",
    "openapi3-ts": "^4.1.2",
    "pg": "^8.16.3",
    "react": "19.2.3",
    "react-compare-slider": "3.1.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.69.0",
    "react-use-measure": "^2.1.7",
    "recharts": "^3.8.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.6",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/nextjs-vite": "^10.3.6",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "4.0.16",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "prisma": "^6.0.0",
    "storybook": "^10.3.6",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.16"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "@babel/core": "^7.29.6",
      "@parcel/watcher>picomatch": "^4.0.7",
      "baseline-browser-mapping": "^2.11.23",
      "browserslist": "^4.28.9",
      "deepmerge-ts": "^8.0.2",
      "defu": "^6.1.7",
      "effect": "^3.22.2",
      "source-map-js": "1.2.2",
      "yaml": "^2.9.1"
    }
  }
}
